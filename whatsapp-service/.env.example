# See README.md for the full setup walkthrough.

# Any value you choose -- this is what the Laravel backend (OPENWA_API_KEY
# in archintent-backend/.env) and you (when visiting /qr) both send back.
WA_API_KEY=

# archintent-backend's own base URL (no trailing slash), so this service can
# save/restore its WhatsApp login via /api/internal/whatsapp-session.
LARAVEL_BASE_URL=https://archintent-api.herokuapp.com
# Must match INTERNAL_API_KEY in archintent-backend/.env exactly.
INTERNAL_API_KEY=

# Only needed if you run more than one WhatsApp number/session through
# this service; otherwise the default is fine.
# WA_SESSION_ID=default

# Set by Heroku itself in production -- only needed here for local runs.
# PORT=8080
