MODEL_NAME=all-MiniLM-L6-v2
TOP_K=10

# ---------------------------------------------------------------------
# Voice transcription -- Groq whisper-large-v3 (see transcriber.py)
# ---------------------------------------------------------------------
# One or more Groq API keys, newline or comma separated. Get them at
# console.groq.com/keys. Duplicates are ignored.
#
# Groq's free tier allows 20 RPM / 2,000 RPD / 7,200 audio-sec-per-hour
# per *organization*, so pooling keys only multiplies capacity when each
# key belongs to a separate account. key_pool.py hands them out
# round-robin and skips any key without headroom, so no single key is
# driven into its own limit.
#
# Without this set, /transcribe returns a clear "not configured" error
# rather than crashing; matching and keyword extraction are unaffected.
GROQ_API_KEYS=

# Optional overrides. Defaults match the free tier; raise them if the
# keys are on a paid plan.
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_RPM=20
# GROQ_RPD=2000
# GROQ_ASH=7200
# GROQ_ASD=28800
# How many keys one request may re-roll through before giving up.
# GROQ_MAX_ATTEMPTS=4

# Hard cap on uploaded audio size, enforced before the file is sent to
# Groq (their own limit is 25MB on the free tier; kept lower here).
MAX_AUDIO_BYTES=15728640
