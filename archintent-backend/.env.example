APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=archintent
REVERB_APP_KEY=archintent-key
REVERB_APP_SECRET=archintent-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
# Local/testing only: set to false if your machine cannot validate Stripe cert chain.
STRIPE_VERIFY_SSL=true

# Internal service auth (matching ingest job, NLP service callback headers)
INTERNAL_API_KEY=

# Optional remote project matcher: POST {base}/match with JSON body and header X-Internal-Key: INTERNAL_API_KEY
# Response JSON must include "matches" array; on failure or when unset, the app uses heuristic matching.
# Same base URL also backs ProjectIntentController's /extract-keywords
# (keyword decoding) and /transcribe (voice-to-text) proxy endpoints --
# see nlp-service/keyword_extractor.py and nlp-service/transcriber.py.
MATCHING_NLP_SERVICE_URL=

# Phone OTP. OTP_SMS_DRIVER = smsgate | twilio | none (unset: inferred from whichever credentials below are filled in).
OTP_SMS_DRIVER=
# SMS Gateway for Android (https://sms-gate.app, open source): install the app on an Android phone with a
# Pakistani SIM, switch on "Cloud Server", tap Online, and copy the username/password it shows.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
# Twilio (a Trial account can only text numbers verified on that account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OTP_TTL_SECONDS=600
# Local QA only: when true, POST /auth/phone-otp/send includes plaintext dev_code in JSON (never enable in production)
OTP_EXPOSE_CODE_IN_RESPONSE=false

# Email verification. OTP_EMAIL_DRIVER = firebase | mail | mailtrap
# (unset: firebase once FIREBASE_WEB_API_KEY is set, else mailtrap while MAILTRAP_API_TOKEN is set, else mail).
OTP_EMAIL_DRIVER=
# "firebase": Firebase emails a verification LINK (free Spark plan, 1000/day, any recipient).
# Firebase console > Project settings > General > Web API Key. Enable Authentication > Sign-in method > Email/Password.
FIREBASE_WEB_API_KEY=
# Optional "Continue" link on Firebase's confirmation page; its domain must be in Authentication > Settings > Authorized domains.
FIREBASE_EMAIL_CONTINUE_URL=
# "mail" sends a 6-digit code through the MAIL_* SMTP settings above. Gmail (free, ~500/day, any recipient):
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#   MAIL_USERNAME=you@gmail.com  MAIL_PASSWORD=<16-char App Password>  MAIL_FROM_ADDRESS=you@gmail.com
# Mailtrap: the demo sending domain only delivers to the account owner's own address.
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=hello@demomailtrap.co
MAILTRAP_FROM_NAME=ArchIntent
MAILTRAP_INBOX_ID=
MAILTRAP_MODE=sandbox

# Stripe Connect (Express) — return URLs should point at your SPA after onboarding
STRIPE_CONNECT_COUNTRY=PK
STRIPE_CONNECT_TRANSFER_ON_RELEASE=true
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/dashboard/architect?stripe=return
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/dashboard/architect?stripe=refresh

# Lowercase ISO currency for Stripe amounts (must match Connect account country rules)
PAYMENT_CURRENCY=pkr

# Platform commission on design-phase project payments (percent of gross; architect receives the remainder)
PLATFORM_FEE_PERCENT=10

VITE_APP_NAME="${APP_NAME}"
