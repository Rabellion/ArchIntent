# =====================================================================
#  ArchIntent monorepo .gitignore
#  Covers: archintent-backend (Laravel/PHP), archintent-frontend (Vite/
#  React/TS), nlp-service (Python/FastAPI), fyp-report (LaTeX).
# =====================================================================

# ---------------------------------------------------------------------
# SECRETS -- never commit real credentials.
# .env.example files ARE tracked (they hold placeholders only).
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# ---------------------------------------------------------------------
# PHP / Laravel (archintent-backend)
# ---------------------------------------------------------------------
archintent-backend/vendor/
archintent-backend/composer.phar
archintent-backend/storage/*.key
archintent-backend/storage/app/*
!archintent-backend/storage/app/.gitignore
!archintent-backend/storage/app/public/.gitignore
archintent-backend/storage/framework/cache/*
archintent-backend/storage/framework/sessions/*
archintent-backend/storage/framework/testing/*
archintent-backend/storage/framework/views/*
!archintent-backend/storage/framework/cache/.gitignore
!archintent-backend/storage/framework/sessions/.gitignore
!archintent-backend/storage/framework/testing/.gitignore
!archintent-backend/storage/framework/views/.gitignore
archintent-backend/storage/logs/*
!archintent-backend/storage/logs/.gitignore
archintent-backend/.phpunit.result.cache
archintent-backend/Homestead.json
archintent-backend/Homestead.yaml
archintent-backend/auth.json
archintent-backend/npm-debug.log
archintent-backend/yarn-error.log
archintent-backend/bootstrap/ssr
archintent-backend/public/hot
archintent-backend/public/storage
archintent-backend/public/build

# ---------------------------------------------------------------------
# Node / Vite (archintent-frontend)
# ---------------------------------------------------------------------
archintent-frontend/node_modules/
archintent-frontend/dist/
archintent-frontend/dist-ssr/
archintent-frontend/*.local
archintent-frontend/npm-debug.log*
archintent-frontend/yarn-debug.log*
archintent-frontend/yarn-error.log*
archintent-frontend/pnpm-debug.log*

# ---------------------------------------------------------------------
# Python (nlp-service)
# ---------------------------------------------------------------------
nlp-service/__pycache__/
nlp-service/*.py[cod]
nlp-service/*.egg-info/
nlp-service/.venv/
nlp-service/venv/
nlp-service/.pytest_cache/

# Any Python tooling caches, wherever they show up (ruff, mypy, etc.)
**/__pycache__/
**/.ruff_cache/
**/.mypy_cache/
**/.pytest_cache/

# ---------------------------------------------------------------------
# LaTeX build artefacts (fyp-report)
# ---------------------------------------------------------------------
fyp-report/**/*.aux
fyp-report/**/*.bbl
fyp-report/**/*.bcf
fyp-report/**/*.blg
fyp-report/**/*.lof
fyp-report/**/*.log
fyp-report/**/*.lot
fyp-report/**/*.out
fyp-report/**/*.run.xml
fyp-report/**/*.toc
fyp-report/**/*.synctex.gz
fyp-report/**/*.pdf

# ---------------------------------------------------------------------
# Project documents not meant for the public repo
# (internal working docs, generated reports, DB dumps, editor exports)
# ---------------------------------------------------------------------
ArchIntent-FYP-Report-Overleaf.zip
REGISTRATION_FIX_SUMMARY.md
Rubrics for Evaluation of FYP Report.docx
TEST_PLAN.md
VERIFICATION_REPORT.md
archintent.sql

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp

# Local scratch / IDE project files some editors drop at the repo root
.claude/settings.local.json
.playwright-mcp/

# ---------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------
# Raw Groq API keys for the Whisper key pool. These are injected into the
# NLP service through the GROQ_API_KEYS config var, never committed.
groq_keys.txt
groq_keys*.txt
*_keys.txt
